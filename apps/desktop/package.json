{
  "name": "@xiong/desktop",
  "version": "0.1.0",
  "description": "Xiong local-first AI role-playing desktop application",
  "author": "Xiong Contributors",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "package:win": "corepack pnpm build && electron-builder --win --dir && node ../../scripts/rebuild-better-sqlite3-node.cjs"
  },
  "dependencies": {
    "@xiong/core": "workspace:*",
    "@xiong/db": "workspace:*",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "42.5.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "vite": "7.3.6"
  },
  "build": {
    "appId": "com.xiong.desktop",
    "productName": "Xiong",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "dir"
      ]
    }
  }
}
